# Telegram API Credentials
# Get from https://my.telegram.org/apps
TELEGRAM_API_ID=your_api_id_here
TELEGRAM_API_HASH=your_api_hash_here

# ================================================================================
# LLM Provider Configuration (OpenAI-compatible API)
# ================================================================================
# The system now supports any OpenAI-compatible LLM API provider.
# Supports: Cerebras, Groq, Together, OpenAI, local/self-hosted, and more.
#
# How to switch providers:
# 1. Get API credentials from your chosen provider
# 2. Update LLM_* variables below
# 3. Run normally - no code changes needed!
#
# ================================================================================

# --- Cerebras (recommended for quality, high context) ---
LLM_PROVIDER=cerebras
LLM_API_URL=https://api.cerebras.ai/v1
LLM_API_KEY=sk-...your-cerebras-api-key-here...
LLM_MODEL=llama3.1-70b

# --- Groq (fast inference, free tier available) ---
# LLM_PROVIDER=groq
# LLM_API_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_...your-groq-api-key-here...
# LLM_MODEL=mixtral-8x7b-32768

# --- Together AI (flexible model selection) ---
# LLM_PROVIDER=together
# LLM_API_URL=https://api.together.xyz/v1
# LLM_API_KEY=your-together-api-key-here
# LLM_MODEL=meta-llama/Llama-3-70b-chat-hf

# --- OpenAI (GPT models) ---
# LLM_PROVIDER=openai
# LLM_API_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...your-openai-api-key-here...
# LLM_MODEL=gpt-4-turbo

# --- Local/Self-hosted (Ollama, vLLM, etc.) ---
# LLM_PROVIDER=local
# LLM_API_URL=http://localhost:8000/v1
# LLM_API_KEY=not-needed-for-local
# LLM_MODEL=your-local-model-name

# LLM Generation Settings
TEMPERATURE=0.0
MAX_TOKENS_RESPONSE=4000
MAX_TOKENS_PER_CHUNK=50000

# (Optional) Telegram Bot Token for sending digests
# Get from @BotFather
TELEGRAM_BOT_TOKEN=

# (Optional) Channel for publishing digest (e.g., @my_channel)
OUTPUT_TELEGRAM_CHANNEL=

# ================================================================================
# Legacy: CEREBRAS_API_KEY and CEREBRAS_MODEL
# ================================================================================
# These are deprecated but supported for backward compatibility.
# If LLM_API_KEY is not set, it will fall back to CEREBRAS_API_KEY.
# If LLM_MODEL is not set, it will fall back to CEREBRAS_MODEL.
#
# CEREBRAS_API_KEY=your_cerebras_api_key_here
# CEREBRAS_MODEL=llama3.1-70b
